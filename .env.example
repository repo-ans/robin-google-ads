# Local scripts only (scripts/). Copy to .env (gitignored). Never used by the web build.

# Local PostgreSQL for scripts/test-db-local.mjs (migrations + RLS tests, no Docker).
LOCAL_PG_URL=postgresql://postgres:<password>@localhost:5432/postgres

# FF Supabase DEV project for scripts/test-auth-block.mjs (creates and deletes test logins).
SUPABASE_URL=https://<ff-dev-project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
