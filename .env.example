# Local scripts only (scripts/). Copy to .env (gitignored). Never used by the web build.

# Local PostgreSQL for scripts/test-db-local.mjs (migrations + RLS tests, no Docker).
LOCAL_PG_URL=postgresql://postgres:<password>@localhost:5432/postgres

# FF Supabase DEV project for scripts/test-auth-block.mjs (creates and deletes test logins).
SUPABASE_URL=https://<ff-dev-project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# scripts/ff.mjs - the FF command line used by the Claude Code skills (.claude/skills).
# Your own dashboard login (ff_staff or rob_admin). Reads go through RLS, actions through n8n.
# Never put a service role key or a Google Ads secret here.
FF_SUPABASE_URL=https://<ff-project>.supabase.co
FF_SUPABASE_ANON_KEY=
FF_N8N_BASE_URL=https://<ff-n8n-host>/webhook
FF_EMAIL=
FF_PASSWORD=
