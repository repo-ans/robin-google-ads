# Copy to web/.env.local for local development. Netlify: set the same names in the site's env vars.
# Local Supabase values come from `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# n8n webhook base, without a trailing slash. Paths are fixed in code (ff/whoami, ff/sync-now, ...).
VITE_N8N_BASE_URL=https://n8n.example.com/webhook
# development | production. Anything other than production shows a TEST badge (Phase 3).
VITE_APP_ENV=development
